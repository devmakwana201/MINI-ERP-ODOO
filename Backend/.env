# =============================================================================
# AGRI POS BACKEND - ENVIRONMENT CONFIGURATION
# =============================================================================
# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
APP_NAME="MINI ERP"
APP_VERSION=1.0.0
APP_DESCRIPTION="Backend for MINI ERP System"
SUPPORT_EMAIL=support@minierp.com
TZ=Asia/Kolkata
# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=8003
HOST=localhost
BASE_URL=http://localhost
# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_PORT=3306

# DB_HOST=192.168.120.47
# DB_USER=aitlroot
# DB_PASS=Admin@123
DB_HOST=localhost
DB_USER=root
DB_PASS=root

DB_NAME=univia_server_v3
DB_CONNECTION_LIMIT=100              # Max number of connections in pool (default: 100, old: 10)
DB_QUEUE_LIMIT=50                    # Max queued connection requests (default: 50, 0 = unlimited)
DB_CONNECT_TIMEOUT=30000             # Connection timeout in ms - time to establish connection (default: 30000)
DB_MAX_IDLE=10                       # Max idle connections to maintain (default: 10)
DB_IDLE_TIMEOUT=60000                # Idle connection timeout in ms (default: 60000)

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# POS JWT Configuration (Separate from regular user JWT)
POS_JWT_SECRET=
POS_JWT_EXPIRES_IN=365d
# Installation JWT Configuration (For 3-step installation flow)
INSTALLATION_JWT_SECRET=
INSTALLATION_JWT_EXPIRES_IN=1h
# Security Settings
BCRYPT_ROUNDS=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
DB_BACKUP_TOKEN=
API_KEY=
# Encryption
ENC_KEY=
# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf
# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=debug
LOG_MAX_FILES=7d
LOG_MAX_SIZE=20m
# =============================================================================
# CRON JOBS CONFIGURATION
# =============================================================================
BACKUP_SCHEDULE="0 2 * * *"
CLEANUP_SCHEDULE="0 2 * * *"
CLEANUP_AGE_HOURS=48
# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_BACKUPS=true
ENABLE_CLEANUP=true
ENABLE_MAINTENANCE=false
# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
NGROK_AUTH_TOKEN=
# =============================================================================
# SMS/OTP Configuration (MSG91)
# =============================================================================
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# =============================================================================
# POS Activation Configuration
# =============================================================================
ACTIVATION_ALERT_EMAIL=mr.devmakwana2004@gmail.com
DB_SCRIPT_PATH=dbscript.sql
MAX_ACTIVATION_COUNT=3
DEVICE_INACTIVITY_MINUTES=15
# =============================================================================
# WhatsApp Notification Configuration
# =============================================================================
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=
WHATSAPP_MAX_RETRIES=3
WHATSAPP_TIMEOUT=30000
WHATSAPP_RETRY_DELAY=1000
WHATSAPP_CONNECTION_TIMEOUT=10000
# =============================================================================
# Frontend URLs for notifications
# =============================================================================
FRONTEND_BASE_URL=
COMPANY_NAME=MiniERP